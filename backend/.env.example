# Banco (TiDB Cloud) - mesmos nomes do banco.env
DB_HOST=
DB_PORT=4000
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=agenda_eventos

# Auth
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=8h

# URL(s) do front separadas por virgula. Vazio = libera todas (so para dev)
CORS_ORIGIN=https://seu-front.vercel.app,http://localhost:8443

# Usado apenas pelo "npm run seed" (se vazio, gera senha aleatoria e imprime)
SEED_ADMIN_PASSWORD=
SEED_REQUESTER_PASSWORD=
